{
  "name": "warehouse-inventory-backend",
  "version": "1.0.0",
  "description": "Backend API for the Warehouse Inventory System (Express, layered architecture)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:reset": "node --env-file-if-exists=.env src/db/seed.js --reset",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
